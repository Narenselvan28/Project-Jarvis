# ReFlow: Adaptive Production Intelligence Environment Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000

# Authentication & Security Keys
SECRET_KEY=reflow-production-secret-key-2026
JWT_SECRET_KEY=reflow-production-jwt-secret-key-32bytes-long!
JWT_EXPIRES_HOURS=24

# Application-Level AES-256-GCM Encryption Key (Must be 32 bytes for AES-256)
AES_ENCRYPTION_KEY=reflow-super-secret-aes-key-32b!

# MongoDB Configuration
MONGO_URI=mongodb://127.0.0.1:27017/production_planning
MONGO_DB_NAME=production_planning

# Google OR-Tools CP-SAT Solver Configuration
CP_SAT_TIME_LIMIT_SECONDS=30
WEIGHT_TARDINESS=10.0
WEIGHT_COST=1.0
WEIGHT_DOWNTIME=2.0
WEIGHT_SCHEDULE_CHANGE=5.0
WEIGHT_OPERATIONAL_RISK=4.0
