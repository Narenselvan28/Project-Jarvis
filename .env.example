# ReFlow Application Environment Configuration Example
# Copy this file to .env and configure values for your environment

# Database Configuration
# DATABASE_MODE options: auto (Atlas with Local fallback), atlas (Atlas only), local (Local only)
DATABASE_MODE=auto
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reflow?retryWrites=true&w=majority&appName=Cluster0
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=reflow
MONGODB_CONNECTION_TIMEOUT_MS=5000

# Server & Security
PORT=5000
SECRET_KEY=reflow-flask-production-secret-key-2026
JWT_SECRET_KEY=reflow-jwt-super-secret-scheduling-key-2026
JWT_EXPIRES_HOURS=24
AES_ENCRYPTION_KEY=reflow-super-secret-aes-key-32b!
CORS_ORIGINS=*

# OR-Tools Solver Horizon & Weights
CP_SAT_TIME_LIMIT_SECONDS=30
WEIGHT_TARDINESS=10.0
WEIGHT_COST=1.0
WEIGHT_DOWNTIME=2.0
WEIGHT_SCHEDULE_CHANGE=5.0
WEIGHT_OPERATIONAL_RISK=4.0
