# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=adaptive-scheduling-secret-key-prod-2026
JWT_SECRET_KEY=jwt-super-secret-scheduling-key-2026
JWT_EXPIRES_HOURS=24
PORT=5000

# Database Configuration
# Set DB_DRIVER to 'mysql' to connect to local MySQL 8+, or 'sqlite' for zero-setup local dev
DB_DRIVER=sqlite
DATABASE_URL=sqlite:///adaptive_factory.db

# MySQL 8+ Parameters (active when DB_DRIVER=mysql)
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=adaptive_factory

# Google OR-Tools CP-SAT Solver Weights & Time Limit
CP_SAT_TIME_LIMIT_SECONDS=30
WEIGHT_TARDINESS=10.0
WEIGHT_COST=1.0
WEIGHT_DOWNTIME=2.0
WEIGHT_SCHEDULE_CHANGE=5.0
WEIGHT_OPERATIONAL_RISK=4.0
