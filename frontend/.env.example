# ReFlow Frontend Environment Variables
# For local development with Webpack devServer proxy:
# Leave blank or omit (defaults to /api/v1 and window.location)

# For production deployment (e.g., Vercel pointing to Render backend):
REACT_APP_API_URL=https://jarvis-bknd.onrender.com
REACT_APP_SOCKET_URL=https://jarvis-bknd.onrender.com
